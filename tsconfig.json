{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["chrome", "vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*", "*.ts", ".wxt/**/*"]
}
