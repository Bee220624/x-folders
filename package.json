    "@types/chrome": "^0.1.32",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@11.25.0"
